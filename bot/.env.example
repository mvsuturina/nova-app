# Supabase — тот же проект, что у SPA (см. Nova/config.js), но SERVICE ROLE key,
# не anon key. Взять в Supabase Dashboard → Project Settings → API → service_role.
# НИКОГДА не коммитить .env с реальными значениями, никогда не класть service role
# ключ в SPA/config.js.
SUPABASE_URL=https://unckamxhresccxorkkkw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Токен бота, выданный @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# MVP: один боевой аккаунт, без полноценного auth-флоу — user_id захардкожен здесь.
# Боевой аккаунт указан в CLAUDE.md проекта: d0f3ba43-2690-46d1-8d1e-2b8f4c0abec5
# Для тестирования используй отдельного тестового бота (свой TELEGRAM_BOT_TOKEN)
# и тестовый Supabase-аккаунт — не боевой user_id.
NOVA_USER_ID=

# Таймзона пользователя — используется и для "план на сегодня" (date), и для
# вычисления окна напоминаний. В SPA таймзона берётся автоматически из браузера
# (userTimezone в js/state.js через Intl.DateTimeFormat) — здесь, у отдельного
# серверного процесса без браузера, её нужно указать руками, и она должна
# совпадать с реальным часовым поясом пользователя, а не с сервером/хостингом.
NOVA_TIMEZONE=Europe/Moscow
