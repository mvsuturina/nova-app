# Те же credentials, что уже используются ботом (bot/.env) — тот же сервисный аккаунт
# и та же таблица. Можно скопировать значения оттуда 1:1.

# Содержимое JSON-ключа service account целиком, ОДНОЙ строкой.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID таблицы из её URL: https://docs.google.com/spreadsheets/d/ЭТА_ЧАСТЬ/edit
GOOGLE_SHEET_ID=
